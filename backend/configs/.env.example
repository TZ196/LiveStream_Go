# 环境变量示例，程序不会自动读取此文件。
# 命令行参数优先于环境变量；样例中不要填写真实凭据。
LIVESTREAM_HTTP_ADDR=127.0.0.1:8080
LIVESTREAM_LOG_LEVEL=info
LIVESTREAM_SHUTDOWN_TIMEOUT=30s

# API 必填：至少 32 随机字节的 Base64 编码；在本地生成，不提交真实值。
# 独立迁移命令不读取此项。
LIVESTREAM_JWT_SECRET=

# Go 与本地 Compose 使用同一组 MySQL 配置。
LIVESTREAM_MYSQL_ADDR=127.0.0.1:3306
LIVESTREAM_MYSQL_DATABASE=livestream
LIVESTREAM_MYSQL_USER=livestream
# 在本地 .env 中填写自己的随机密码，不提交到 Git。
LIVESTREAM_MYSQL_PASSWORD=
# 仅供 Compose 首次初始化使用，Go API 和迁移命令均不读取 root 密码。
MYSQL_ROOT_PASSWORD=
